    "# Estado del peatón por localidad (todos los siniestros georreferenciados)\n",
    "COL_LOC_TABLA = next((c for c in ['LOCALIDAD', 'LOCALIDAD_DESC', 'LOCALIDAD_ACC', 'LOCALIDAD_HECHO']\n",
    "                      if c in siniestros.columns), None)\n",
    "if COL_LOC_TABLA is None:\n",
    "    raise ValueError(f\"No se encontró columna de localidad en siniestros: {sorted(siniestros.columns)}\")\n",
    "\n",
    "tmp = siniestros[[COL_LOC_TABLA, 'ESTADO']].copy()\n",
    "tmp['localidad'] = tmp[COL_LOC_TABLA].map(normalizar_texto).fillna('SIN LOCALIDAD')\n",
    "tmp['estado'] = tmp['ESTADO'].map(normalizar_texto)\n",
    "\n",
    "estado_localidad = (\n",
    "    pd.crosstab(tmp['localidad'], tmp['estado'])\n",
    "      .reindex(columns=['ILESO', 'HERIDO', 'MUERTO'], fill_value=0)\n",
    "      .rename(columns={'ILESO': 'ileso', 'HERIDO': 'herido', 'MUERTO': 'muerto'})\n",
    ")\n",
    "estado_localidad['total'] = estado_localidad.sum(axis=1)\n",
    "estado_localidad = (\n",
    "    estado_localidad.sort_values('total', ascending=False)\n",
    "                    .reset_index()\n",
    ")\n",
    "estado_localidad.columns.name = None\n",
    "\n",
    "# Fila de totales\n",
    "fila_total = {'localidad': 'TOTAL', **estado_localidad[['ileso', 'herido', 'muerto', 'total']].sum().to_dict()}\n",
    "estado_localidad = pd.concat([estado_localidad, pd.DataFrame([fila_total])], ignore_index=True)\n",
    "\n",
    "# Control: el total debe coincidir con el número de siniestros\n",
    "assert estado_localidad.loc[estado_localidad['localidad'] == 'TOTAL', 'total'].iloc[0] == len(siniestros)\n",
    "\n",
    "estado_localidad"
   ]
  },
