    "\n",
    "# Verificaciones defensivas (antes de que cualquier fillna(0) posterior pueda enmascarar el\n",
    "# problema en silencio: una vía con población 0 o nula no es lo mismo que una vía sin\n",
    "# siniestros, y confundirlas invalida cualquier offset o covariable logarítmica que la use).\n",
    "n_sin_poblacion = poblacion_segmento['poblacion_localidad'].isna().sum()\n",
    "n_poblacion_no_positiva = (poblacion_segmento['poblacion_localidad'].fillna(1) <= 0).sum()\n",
    "n_valores_distintos = poblacion_segmento['poblacion_localidad'].nunique()\n",
    "print(f\"\\nVías SIN población asignada          : {n_sin_poblacion:,} (se espera 0)\")\n",
