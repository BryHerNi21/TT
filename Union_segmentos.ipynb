    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import geopandas as gpd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.ticker import FuncFormatter\n",
    "import unicodedata\n",
    "\n",
    "pd.set_option('display.max_columns', 80)\n",
    "plt.rcParams['figure.figsize'] = (9, 6)\n",
    "\n",
    "# ---------------------------------------------------------------\n",
    "# PARÁMETROS DEL DISEÑO METODOLÓGICO\n",
    "# ---------------------------------------------------------------\n",
    "CRS_PROYECTO = 3116          # MAGNA-SIRGAS / Colombia Bogotá zone (metros)\n",
    "UMBRAL_RUIDO = 4             # descarta geometrías degeneradas de digitalización\n",
    "UMBRAL_PEATONAL_M = 15       # distancia máxima a la que una vía se considera 'cubierta' por malla peatonal\n",
    "PASO_COBERTURA_M = 5         # separación aprox. entre puntos de muestreo a lo largo de cada vía\n",
    "UMBRAL_SINIESTROS_M = 30     # distancia máxima para asignar un siniestro a una vía\n",
    "\n",
    "DIR_PROC = 'Data/processed'\n",
    "os.makedirs(DIR_PROC, exist_ok=True)\n",
    "\n",
    "print(f\"Umbral peatonal: {UMBRAL_PEATONAL_M} m | Umbral siniestros: {UMBRAL_SINIESTROS_M} m\")"
