    "def construir_dataset():\n",
    "    # MVI_VELREG (velocidad reglamentaria) y MVINUMC (número de calzadas) son covariables de\n",
    "    # diseño vial del modelo: se conservan explícitamente (no por 'if c in columns').\n",
    "    ds = segmentos[['seg_id', 'vial_id', 'long_seg_m', 'geometry', *COLS_DISENO_VIAL] +\n",
    "                   [c for c in ['MVITIPO', 'MVISVIA'] if c in segmentos.columns]].copy()\n",
    "\n",
    "    ds = ds.merge(puentes_agg,        on='seg_id', how='left')\n",
    "    ds = ds.merge(semaforos_agg,      on='seg_id', how='left')\n",
    "    ds = ds.merge(peatonal_agg,       on='seg_id', how='left')\n",
    "    ds = ds.merge(siniestros_agg,     on='seg_id', how='left')\n",
    "    # Población por localidad asignada directamente a la vía (sección 4.7.1-4.7.3): cubre\n",
    "    # el 100% de la red, tenga o no siniestros, a diferencia del enfoque vía-siniestros.\n",
    "    ds = ds.merge(poblacion_segmento, on='seg_id', how='left')\n",
    "\n",
    "    # Conteos ausentes = ausencia real del fenómeno, no dato faltante\n",
    "    cols_conteo = [c for c in ds.columns if c.startswith('n_')]\n",
    "    ds[cols_conteo] = ds[cols_conteo].fillna(0)\n",
    "    for c in cols_conteo:\n",
    "        if ds[c].dropna().mod(1).eq(0).all():\n",
    "            ds[c] = ds[c].astype(int)\n",
    "\n",
    "    # Cobertura peatonal: peatonal_agg trae una fila por vía y sin NaN (0 = sin cobertura)\n",
    "    ds['tiene_infra_peatonal'] = ds['ratio_cobertura_peatonal'] > 0\n",
    "\n",
    "    if 'n_peatones_afectados' in ds.columns:\n",
    "        ds['tuvo_siniestro'] = ds['n_peatones_afectados'] > 0\n",
    "    return ds\n",
    "\n",
    "dataset_final = construir_dataset()\n",
    "\n",
    "print(f\"Dataset final: {dataset_final.shape}\")\n",
    "print(f\"% con cobertura peatonal (> 0)           : {dataset_final['tiene_infra_peatonal'].mean()*100:.2f}%\")\n",
    "print(f\"Cobertura peatonal media (0-1)           : {dataset_final['ratio_cobertura_peatonal'].mean():.3f}\")\n",
    "print(f\"Velocidad reglamentaria / calzadas       : \"\n",
    "      f\"{dataset_final['MVI_VELREG'].notna().mean()*100:.1f}% / {dataset_final['MVINUMC'].notna().mean()*100:.1f}% con dato\")\n",
    "print(f\"% con siniestro                         : {dataset_final['tuvo_siniestro'].mean()*100:.2f}%\")\n",
    "print(f\"Siniestros totales capturados            : {dataset_final['n_peatones_afectados'].sum():,}\")\n",
    "print(f\"% con población de localidad asignada    : {dataset_final['poblacion_localidad'].notna().mean()*100:.2f}%\")\n",
    "dataset_final.head()"
   ]
  },
