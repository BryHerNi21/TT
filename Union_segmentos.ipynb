   "source": [
    "def cargar(ruta, nombre):\n",
    "    gdf = gpd.read_file(ruta)\n",
    "    if gdf.crs is None:\n",
    "        raise ValueError(f\"{nombre}: la capa no tiene CRS definido; no se puede asumir.\")\n",
    "    if gdf.crs.to_epsg() != CRS_PROYECTO:\n",
    "        gdf = gdf.to_crs(epsg=CRS_PROYECTO)\n",
    "    n0 = len(gdf)\n",
    "    gdf = gdf[~gdf.geometry.isna() & ~gdf.geometry.is_empty].copy()\n",
    "    print(f\"{nombre:11s}: {n0:>8,} -> {len(gdf):>8,} (descartadas {n0-len(gdf):,} sin geometría)\")\n",
    "    return gdf\n",
    "\n",
    "perimetro  = cargar(\"Data/raw/perimetrourbano (1).gpkg\", 'perimetro')\n",
    "malla      = cargar(f\"{DIR_PROC}/malla_vial_procesada.gpkg\", 'malla')\n",
    "puentes    = cargar(f\"{DIR_PROC}/puentes_procesado.gpkg\", 'puentes')\n",
    "peatonal   = cargar(f\"{DIR_PROC}/peatonal_procesada.gpkg\", 'peatonal')\n",
    "semaforos  = cargar(f\"{DIR_PROC}/semaforos_procesados.gpkg\", 'semaforos')\n",
    "siniestros = cargar(f\"{DIR_PROC}/siniestros_procesados.gpkg\", 'siniestros')\n",
    "\n",
    "# El perímetro se reduce a una sola geometría disuelta: es una máscara, no una tabla.\n",
    "perimetro = gpd.GeoDataFrame(geometry=[perimetro.union_all()], crs=perimetro.crs)\n",
    "\n",
    "for nombre, capa in [('perimetro', perimetro), ('malla', malla), ('puentes', puentes),\n",
    "                     ('peatonal', peatonal), ('semaforos', semaforos), ('siniestros', siniestros)]:\n",
    "    print(f\"{nombre:11s} -> {len(capa):>8,} filas | {capa.crs.to_epsg()} | \"\n",
    "          f\"{sorted(capa.geom_type.unique())}\")"
   ]
  },
