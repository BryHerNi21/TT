    "import unicodedata\n",
    "\n",
    "def normalizar_texto(s):\n",
    "    \"\"\"Mayúsculas, sin tildes, sin espacios sobrantes — para cruces de texto robustos.\"\"\"\n",
    "    if pd.isna(s):\n",
    "        return s\n",
    "    s = str(s).strip().upper()\n",
    "    s = ''.join(c for c in unicodedata.normalize('NFD', s) if unicodedata.category(c) != 'Mn')\n",
    "    return s\n",
    "\n",
    "def canonicalizar_localidad(s):\n",
    "    \"\"\"normalizar_texto + quita el artículo inicial 'LA ': 'LA CANDELARIA' y 'CANDELARIA' deben\n",
    "    dar la misma llave. Es el único de los nombres de las 20 localidades con artículo inicial,\n",
    "    y el que más varía entre fuentes (SDP, SDS, SDM).\"\"\"\n",
    "    s = normalizar_texto(s)\n",
    "    if pd.isna(s):\n",
    "        return s\n",
    "    return s[3:] if s.startswith('LA ') else s\n",
    "\n",
    "poblacion_localidad['loc_norm'] = poblacion_localidad['NOM_LOC'].map(canonicalizar_localidad)"
   ]
