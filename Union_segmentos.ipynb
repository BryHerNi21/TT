   "source": [
    "salida = f'{DIR_PROC}/segmentos_unificado.gpkg'\n",
    "\n",
    "# Capa principal de análisis\n",
    "dataset_final.to_file(salida, layer='segmentos', driver='GPKG')\n",
    "\n",
    "# Versión tabular para modelado (sin geometría)\n",
    "cols_drop = ['seg_id', 'vial_id', 'geometry', 'MVITIPO', 'MVISVIA', 'localidad',\n",
    "       'dist_puente_m', 'long_peatonal_m',\n",
    "       'n_peatones_afectados', 'pct_nocturno', 'ano_min',\n",
    "       'ano_max', 'tiene_infra_peatonal', 'tuvo_siniestro']\n",
    "# 'localidad' se descarta como texto (igual que MVITIPO/MVISVIA); 'poblacion_localidad' y\n",
    "# 'log_poblacion' sí se conservan: son la covariable de exposición poblacional por vía (en\n",
    "# nivel y en logaritmo — esta última es la que entra al modelo según la Tabla 5).\n",
    "\n",
    "# Verificación ANTES del fillna(0) de abajo: una vía sin población real no debe convertirse\n",
    "# en silencio en una vía con población 0 (eso invalidaría log_poblacion, que no admite 0).\n",
    "n_pob_faltante = dataset_final['poblacion_localidad'].isna().sum()\n",
    "n_pob_no_positiva = (dataset_final['poblacion_localidad'].fillna(1) <= 0).sum()\n",
    "assert n_pob_faltante == 0, f\"{n_pob_faltante} vías sin población asignada — revisar sección 4.7 antes de exportar\"\n",
    "assert n_pob_no_positiva == 0, f\"{n_pob_no_positiva} vías con población <= 0 — revisar sección 4.7 antes de exportar\"\n",
    "\n",
    "# Velocidad y carriles: fillna(0) las convertiría en 'velocidad 0' / '0 calzadas' si hubiera\n",
    "# algún NaN; llegan imputadas por KNN desde EDA_Malla_Vial, así que no debe haber ninguno.\n",
    "for c in COLS_DISENO_VIAL:\n",
    "    assert dataset_final[c].notna().all(), f\"{c} tiene {dataset_final[c].isna().sum()} NaN — no exportar\"\n",
    "assert dataset_final['ratio_cobertura_peatonal'].between(0, 1).all()\n",
    "\n",
    "dataset_final = dataset_final.fillna(0)\n",
    "dataset_final.drop(columns=cols_drop).to_csv(\n",
    "    f'{DIR_PROC}/segmentos_unificado.csv', index=False)\n",
    "\n",
    "# Protección explícita: estas variables NO pueden quedar fuera del CSV de modelado.\n",
    "csv_cols = pd.read_csv(f'{DIR_PROC}/segmentos_unificado.csv', nrows=0).columns.tolist()\n",
    "for c in [*COLS_DISENO_VIAL, 'ratio_cobertura_peatonal', 'log_poblacion', 'dist_semaforo_m']:\n",
    "    assert c in csv_cols, f\"{c} no está en el CSV exportado\"\n",
    "print('Columnas del CSV de modelado:', csv_cols)\n",
    "\n",
    "# Tabla de siniestralidad normalizada por población (anexo de proyecciones), por localidad y año\n",
    "if COL_LOCALIDAD_SIN and COL_ANIO_SIN:\n",
    "    resumen_localidad_anio.to_csv(f'{DIR_PROC}/siniestros_tasa_100k_localidad_anio.csv', index=False)\n",
    "\n",
    "print('GeoPackage:', salida, '| capa: segmentos')\n",
    "print('CSV       :', f'{DIR_PROC}/segmentos_unificado.csv')\n",
    "if COL_LOCALIDAD_SIN and COL_ANIO_SIN:\n",
    "    print('CSV       :', f'{DIR_PROC}/siniestros_tasa_100k_localidad_anio.csv')\n",
    "print(f'\\nDataset final: {dataset_final.shape[0]:,} vías x {dataset_final.shape[1]} columnas')"
   ]
