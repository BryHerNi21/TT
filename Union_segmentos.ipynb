    "def agregar_siniestros(umbral_m=UMBRAL_SINIESTROS_M):\n",
    "    base_sin = siniestros.reset_index(drop=True).copy()\n",
    "    base_sin['_elem_id'] = base_sin.index\n",
    "\n",
    "    pares = gpd.sjoin_nearest(\n",
    "        base_sin, segmentos[['seg_id', 'geometry']],\n",
    "        max_distance=umbral_m, distance_col='dist_m'\n",
    "    )\n",
    "\n",
    "    # Empates: sjoin_nearest devuelve TODAS las vías que están a la distancia mínima,\n",
    "    # no solo una. Son especialmente frecuentes en intersecciones, donde el siniestro\n",
    "    # puede quedar equidistante de dos o más vías que convergen en el cruce.\n",
    "    # Criterio de desempate declarado: se conserva la vía de menor `seg_id` entre las\n",
    "    # empatadas. Es arbitrario frente al fenómeno (no hay un criterio sustantivo para\n",
    "    # preferir una rama de la intersección sobre otra), pero es explícito y reproducible,\n",
    "    # a diferencia de depender del orden interno no documentado del índice espacial.\n",
    "    n_pares_antes = len(pares)\n",
    "    pares = pares.sort_values(['_elem_id', 'seg_id']).drop_duplicates(subset='_elem_id', keep='first')\n",
    "    n_empates = n_pares_antes - len(pares)\n",
    "    print(f\"Siniestros con empate de distancia resuelto por menor seg_id: {n_empates}\")\n",
    "\n",
    "    sin_asignar = len(base_sin) - pares['_elem_id'].nunique()\n",
    "    print(f\"Siniestros sin vía asignada a {umbral_m} m: {sin_asignar}\")\n",
    "\n",
    "    # Tratamiento por tipo de lugar del siniestro (DISENO_LUGAR): no hay reglas distintas\n",
    "    # por categoría. Todo siniestro —ocurra en tramo de vía, intersección, lote/predio,\n",
    "    # cicloruta, túnel o puente— se asigna por el mismo procedimiento de vecino más\n",
    "    # próximo contra la capa de vías, porque la malla vial es la única capa de destino\n",
    "    # disponible para esta unión (no existe una capa de nodos de intersección ni de\n",
    "    # ciclorrutas/túneles/puentes independiente a la que asignar esos casos). Para los\n",
    "    # siniestros en intersección, esto reparte el evento entre las vías que convergen en\n",
    "    # el cruce (resuelto arriba por menor seg_id); para los ocurridos en lote, cicloruta,\n",
    "    # túnel o puente, el siniestro se asigna a la vía más cercana aunque el lugar exacto\n",
    "    # no sea, en sentido estricto, un tramo de la Malla Vial Integral.\n",
    "    if 'DISENO_LUGAR' in base_sin.columns:\n",
    "        cobertura_diseno = (\n",
    "            base_sin.assign(_asignado=base_sin['_elem_id'].isin(pares['_elem_id']))\n",
    "                    .groupby('DISENO_LUGAR')['_asignado']\n",
    "                    .agg(n='size', asignados='sum')\n",
    "        )\n",
    "        cobertura_diseno['pct_asignado'] = (cobertura_diseno['asignados'] / cobertura_diseno['n'] * 100).round(2)\n",
    "        print(\"\\nCobertura de asignación por tipo de lugar del siniestro (DISENO_LUGAR):\")\n",
    "        print(cobertura_diseno.sort_values('n', ascending=False))\n",
    "\n",
    "\n",
    "    col_acc = 'CODIGO_ACCIDENTE' if 'CODIGO_ACCIDENTE' in pares.columns else '_elem_id'\n",
    "\n",
    "    agg = {'n_peatones_afectados': ('_elem_id', 'nunique'),\n",
    "           'n_siniestros': (col_acc, 'nunique')}\n",
    "    if 'HORA_DIA' in pares.columns:\n",
    "        agg['pct_nocturno'] = ('HORA_DIA', lambda s: ((s >= 19) | (s <= 5)).mean() * 100)\n",
    "    # La población ya no se agrega aquí: se asigna a cada vía directamente por su\n",
    "    # localidad (sección 4.7.1-4.7.3), sin pasar por los siniestros que caigan cerca.\n",
    "\n",
    "    base = pares.groupby('seg_id').agg(**agg).reset_index()\n",
    "\n",
    "    # Desagregación por gravedad: una columna por estado del peatón (se excluye 'ileso',\n",
    "    # no aporta como variable de este dataset)\n",
    "    if 'ESTADO' in pares.columns:\n",
    "        piv = (pd.crosstab(pares['seg_id'], pares['ESTADO'])\n",
    "                 .add_prefix('n_').rename(columns=str.lower).reset_index())\n",
    "        if 'n_ileso' in piv.columns:\n",
    "            piv = piv.drop(columns='n_ileso')\n",
    "        base = base.merge(piv, on='seg_id', how='left')\n",
    "\n",
    "    # Año más reciente y rango temporal cubierto en la vía\n",
    "    if 'ANO_OCURRENCIA_ACC' in pares.columns:\n",
    "        años = (pares.groupby('seg_id')['ANO_OCURRENCIA_ACC']\n",
    "                     .agg(ano_min='min', ano_max='max').reset_index())\n",
    "        base = base.merge(años, on='seg_id', how='left')\n",
    "\n",
    "    return base\n",
    "\n",
    "siniestros_agg = agregar_siniestros()\n",
    "\n",
    "print(f\"\\nVías con siniestro: {len(siniestros_agg):,} ({len(siniestros_agg)/len(segmentos)*100:.2f}%) | \"\n",
    "      f\"total asignaciones: {siniestros_agg['n_peatones_afectados'].sum():,} \"\n",
    "      f\"(peatones afectados reales: {len(siniestros):,})\")"
