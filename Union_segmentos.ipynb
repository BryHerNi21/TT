    "\n",
    "print(\"Columnas leídas   :\", poblacion_raw.columns.tolist())\n",
    "print(\"Años cubiertos    :\", poblacion_raw['ANO'].min(), \"-\", poblacion_raw['ANO'].max())\n",
    "print(\"Valores de SEXO   :\", sorted(poblacion_raw['SEXO'].dropna().unique().tolist()))\n",
    "print(\"N° de localidades :\", poblacion_raw['NOMBRE_LOCALIDAD'].nunique())\n",
    "\n",
    "# POBLACION llega como texto (ver diccionario de datos de la fuente); se limpia a numérico\n",
    "# quedándose solo con dígitos y signo, por si trae separador de miles u otro formato.\n",
    "poblacion_raw['POBLACION'] = pd.to_numeric(\n",
    "    poblacion_raw['POBLACION'].astype(str).str.replace(r'[^\\d\\-]', '', regex=True),\n",
    "    errors='coerce'\n",
    ")\n",
    "poblacion_raw['ANO'] = pd.to_numeric(poblacion_raw['ANO'], errors='coerce').astype('Int64')\n",
    "\n",
    "n_sin_poblacion = poblacion_raw['POBLACION'].isna().sum()\n",
    "if n_sin_poblacion:\n",
    "    print(f\"\\nFilas con POBLACION no convertible a número: {n_sin_poblacion:,} (se excluyen de la suma)\")\n",
    "\n",
    "# Total por localidad-año: la fuente viene desagregada por SEXO y EDAD (edad simple), así\n",
    "# que el total de la localidad es la suma de POBLACION sobre todas esas categorías.\n",
    "poblacion_localidad = (\n",
    "    poblacion_raw.dropna(subset=['POBLACION'])\n",
    "                 .groupby(['NOMBRE_LOCALIDAD', 'ANO'], as_index=False)['POBLACION'].sum()\n",
