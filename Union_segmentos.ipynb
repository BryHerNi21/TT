    "def segmentar_capa(gdf):\n",
    "    \"\"\"Cada vía original (tras explotar multipartes) se conserva como un único\n",
    "    segmento, con su longitud real — ya no se subdivide en tramos de longitud fija.\n",
    "    Se mantiene el nombre por compatibilidad con el resto del pipeline.\"\"\"\n",
    "    base = gdf.explode(index_parts=False).reset_index(drop=True)\n",
    "    base = base[base.geom_type == 'LineString'].copy()\n",
    "\n",
    "    seg = base.copy()\n",
    "    seg['linea_madre_idx'] = seg.index\n",
    "    seg['long_seg_m'] = seg.geometry.length\n",
    "    seg = seg.reset_index(drop=True)\n",
    "    seg['seg_id'] = 'S' + seg.index.astype(str).str.zfill(7)\n",
    "    return seg\n",
    "\n",
    "segmentos = segmentar_capa(malla_base)\n",
    "\n",
    "print(f\"Vías (segmentos): {len(segmentos):,}\")\n",
    "print(segmentos['long_seg_m'].describe().round(2))\n",
    "print(f\"\\nLongitud total de red: {segmentos['long_seg_m'].sum():,.0f} m\")"
