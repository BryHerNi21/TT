    "ax.bar(conteo_vr.index.astype(str), conteo_vr.values,\n",
    "       color='indianred', edgecolor='black', alpha=0.85)\n",
    "ax.set_yscale('log')\n",
    "ax.set_title('Siniestros peatonales por vía (solo vías con >=1)', fontweight='bold')\n",
    "ax.set_xlabel('Nº de peatones afectados en la vía'); ax.set_ylabel('Nº de vías (log)')\n",
    "ax.spines['top'].set_visible(False); ax.spines['right'].set_visible(False)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
