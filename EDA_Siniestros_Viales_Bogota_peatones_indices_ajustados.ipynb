   "source": [
    "candidatas_continuas = ['EDAD', 'HORA_DIA']\n",
    "\n",
    "for col in candidatas_continuas:\n",
    "    # dropna por grupo: kruskal no tolera NaN dentro de los arrays de entrada\n",
    "    grupos = [g.dropna().values for _, g in df.groupby('ESTADO')[col]]\n",
    "    grupos = [g for g in grupos if len(g) > 0]\n",
    "    if len(grupos) < 2:\n",
    "        continue\n",
    "    stat, p = kruskal(*grupos)\n",
    "    print(f\"{col}: H={stat:.2f}, p-valor={p:.4g}\")\n",
    "\n",
    "fig, axes = plt.subplots(1, len(candidatas_continuas), figsize=(6*len(candidatas_continuas), 5))\n",
    "for ax, col in zip(np.atleast_1d(axes), candidatas_continuas):\n",
    "    sns.boxplot(data=df, x='ESTADO', y=col, ax=ax)  # ESTADO, no GRAVEDAD: ver nota abajo\n",
    "    ax.set_title(f'{col} por estado')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
