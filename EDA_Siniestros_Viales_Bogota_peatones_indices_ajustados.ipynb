    "def cramers_v(tabla):\n",
    "    chi2 = chi2_contingency(tabla)[0]\n",
    "    n = tabla.sum().sum()\n",
    "    r, k = tabla.shape\n",
    "    return np.sqrt(chi2 / (n * (min(r, k) - 1)))\n",
    "\n",
    "candidatas_categoricas = [\n",
    " 'CONDICION', 'SEXO',\n",
    "    'LOCALIDAD_DESC', 'DISENO_LUGAR_DESC', 'CLASE',\n",
    "    'DIA_SEMANA', 'MES', 'HORA_DIA',\n",
    "]\n",
    "\n",
    "resultados = []\n",
    "for col in candidatas_categoricas:\n",
    "    if col not in df.columns:\n",
    "        continue\n",
    "    tabla = pd.crosstab(df[col], df['ESTADO'])\n",
    "    tabla = tabla.loc[tabla.sum(axis=1) >= 5]  # descartar categorías con muy pocos casos\n",
    "    if tabla.shape[0] < 2:\n",
    "        continue\n",
    "    chi2, p, dof, _ = chi2_contingency(tabla)\n",
    "    v = cramers_v(tabla)\n",
    "    resultados.append({'variable': col, 'chi2': chi2, 'p_valor': p, 'cramers_v': v, 'n_categorias': tabla.shape[0]})\n",
    "\n",
    "tabla_bivariado_cat = pd.DataFrame(resultados).sort_values('cramers_v', ascending=False)\n",
    "tabla_bivariado_cat\n"
   ]
  },
