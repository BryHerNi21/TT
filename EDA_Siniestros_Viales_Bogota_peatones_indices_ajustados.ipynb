    "# Filtra todas las filas cuyo CODIGO_ACCIDENTE aparece 2 o más veces\n",
    "duplicados = peatonal[peatonal.duplicated(subset=['CODIGO_ACCIDENTE'], keep=False)]\n",
    "\n",
    "# Ordenar por CODIGO_ACCIDENTE para ver las repeticiones agrupadas\n",
    "duplicados = duplicados.sort_values(by='CODIGO_ACCIDENTE')\n",
    "\n",
    "print(f\"Total de filas duplicadas: {len(duplicados)}\")\n",
    "print(f\"Cantidad de códigos únicos repetidos: {duplicados['CODIGO_ACCIDENTE'].nunique()}\")\n",
    "\n",
    "# Mostrar los primeros registros duplicados\n",
    "duplicados"
   ]
