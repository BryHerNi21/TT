   "source": [
    "df = df_total.copy()\n",
    "causa_principal = (\n",
    "    hipotesis\n",
    "    .sort_values('CODIGO_ACCIDENTE')\n",
    "    .drop_duplicates('CODIGO_ACCIDENTE')\n",
    "    .set_index('CODIGO_ACCIDENTE')['CODIGO_CAUSA_DESC']\n",
    "    .rename('CAUSA_PRINCIPAL')\n",
    ")\n",
    "\n",
    "# 4. INFORMACIÓN INDIVIDUAL DE LOS PEATONES\n",
    "\n",
    "peatones = actor_vial.loc[\n",
    "    actor_vial['CONDICION'].eq('PEATON')\n",
    "].copy()\n",
    "\n",
    "# Edad numérica\n",
    "peatones['EDAD'] = pd.to_numeric(\n",
    "    peatones['EDAD'],\n",
    "    errors='coerce'\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. INFORMACIÓN DEL SINIESTRO\n",
    "#    Se agrega a cada peatón\n",
    "# ============================================================\n",
    "info_siniestro = (\n",
    "    siniestros[\n",
    "        [\n",
    "            'CODIGO_ACCIDENTE',\n",
    "            'CODIGO_LOCALIDAD',\n",
    "            'DISENO_LUGAR',\n",
    "            'DIRECCION',\n",
    "            'HORA',\n",
    "            'CLASE',\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates('CODIGO_ACCIDENTE')\n",
    "    .set_index('CODIGO_ACCIDENTE')\n",
    ")\n",
    "peatones = (\n",
    "    peatones\n",
    "    .join(causa_principal, on='CODIGO_ACCIDENTE')\n",
    "    .join(info_siniestro, on='CODIGO_ACCIDENTE')\n",
    ")\n",
    "\n",
    "info_csv = (\n",
    "    df_total[\n",
    "        [\n",
    "            'CODIGO_ACCIDENTE',\n",
    "            'LATITUD',\n",
    "            'LONGITUD',\n",
    "            'DISENO_LUGAR_DESC',\n",
    "            'FECHA_OCURRENCIA_ACC',\n",
    "            'ANO_OCURRENCIA_ACC',\n",
    "            'FECHA_HORA_ACC'\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates('CODIGO_ACCIDENTE')\n",
    "    .set_index('CODIGO_ACCIDENTE')\n",
    ")\n",
    "peatones = (\n",
    "    peatones\n",
    "    .join(info_csv, on='CODIGO_ACCIDENTE'))\n",
    "\n",
    "# ============================================================\n",
    "# 6. ESTADÍSTICAS GENERALES\n",
    "# ============================================================\n",
    "\n",
    "n_general = df['CODIGO_ACCIDENTE'].nunique()\n",
    "\n",
    "gravedad_general = (\n",
    "    df[['CODIGO_ACCIDENTE', 'GRAVEDAD']]\n",
    "    .drop_duplicates('CODIGO_ACCIDENTE')\n",
    "    ['GRAVEDAD']\n",
    "    .value_counts(normalize=True)\n",
    "    .reindex(\n",
    "        ['SOLO DANOS', 'CON HERIDOS', 'CON MUERTOS'],\n",
    "        fill_value=0\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. DATASET FINAL A NIVEL DE PEATÓN\n",
    "# ============================================================\n",
    "\n",
    "df = peatones.copy()\n",
    "\n",
    "n_peatonal = df['CODIGO_ACCIDENTE'].nunique()\n",
    "\n",
    "print(\n",
    "    f\"Siniestros en el dataset general (todos los actores): \"\n",
    "    f\"{n_general:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Siniestros con al menos un peatón involucrado: \"\n",
    "    f\"{n_peatonal:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Porcentaje del total: \"\n",
    "    f\"{n_peatonal / n_general * 100:.1f}%\"\n",
    ")\n",
    "\n",
    "df.head()"
   ]
  },
