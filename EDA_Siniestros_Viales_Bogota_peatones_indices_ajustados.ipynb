   "source": [
    "# 1. Crear la tabla cruzada entre SEXO y ESTADO\n",
    "cruce = pd.crosstab(duplicados['SEXO'], duplicados['ESTADO'])\n",
    "\n",
    "# Seleccionar explícitamente las columnas de interés en caso de que existan otros valores\n",
    "cruce = cruce.reindex(columns=['HERIDO', 'MUERTO'], fill_value=0)\n",
    "cruce = cruce.reindex(index=['MASCULINO', 'FEMENINO'], fill_value=0)\n",
    "\n",
    "# 2. Graficar\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "ax.set_axisbelow(True)\n",
    "ax.grid(axis='y', linestyle='--', alpha=0.6)\n",
    "\n",
    "# Ancho de las barras y posiciones\n",
    "x = range(len(cruce.index))\n",
    "width = 0.35\n",
    "\n",
    "bars1 = ax.bar([p - width/2 for p in x], cruce['HERIDO'], width=width, label='HERIDO', color='darkorange', edgecolor='black', alpha=0.85)\n",
    "bars2 = ax.bar([p + width/2 for p in x], cruce['MUERTO'], width=width, label='MUERTO', color='crimson', edgecolor='black', alpha=0.85)\n",
    "\n",
    "# 3. Anotar valores exactos sobre cada barra\n",
    "for bar in bars1 + bars2:\n",
    "    height = bar.get_height()\n",
    "    if height > 0:\n",
    "        ax.annotate(f'{height:,}',\n",
    "                    xy=(bar.get_x() + bar.get_width() / 2, height),\n",
    "                    xytext=(0, 4),\n",
    "                    textcoords=\"offset points\",\n",
    "                    ha='center', va='bottom', fontsize=9.5, fontweight='bold')\n",
    "\n",
    "# 4. Personalización del gráfico\n",
    "ax.set_title('Cruce de Sexo y Estado (Herido / Muerto) en Registros Duplicados', fontsize=12, fontweight='bold', pad=15)\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(cruce.index, fontweight='bold')\n",
    "ax.set_ylabel('Número de Actores Viales', fontsize=10)\n",
    "ax.set_ylim(0, cruce.values.max() * 1.15)\n",
    "ax.legend(title='Estado', frameon=True)\n",
    "\n",
    "ax.spines['top'].set_visible(False)\n",
    "ax.spines['right'].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
