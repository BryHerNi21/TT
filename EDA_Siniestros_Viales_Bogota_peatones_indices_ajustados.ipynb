    "coord_na = df[['LONGITUD', 'LATITUD']].isna().any(axis=1)\n",
    "en_area = (df['LONGITUD'].between(LON_MIN, LON_MAX) &\n",
    "           df['LATITUD'].between(LAT_MIN, LAT_MAX))\n",
    "estado_ok = df['ESTADO'].isin(['HERIDO', 'MUERTO'])\n",
    "\n",
    "# Conciliación: de dónde sale la diferencia entre el total y lo que se dibuja\n",
    "print(f'Registros totales:                  {len(df):>7,}')\n",
