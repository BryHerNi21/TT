   "source": [
    "import os\n",
    "\n",
    "os.makedirs('Data/processed', exist_ok=True)\n",
    "ruta_salida = 'Data/processed/siniestros_procesados.gpkg'\n",
    "df.to_file(ruta_salida, driver='GPKG')\n",
    "\n",
    "print('Guardado:', ruta_salida, df.shape)"
   ]
