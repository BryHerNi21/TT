    "def construir_mapa_diccionario(dicc):\n",
    "    mapa = {}\n",
    "    for _, row in dicc.iterrows():\n",
    "        clave = (row['HOJA'], row['CAMPO'])\n",
    "        mapa.setdefault(clave, {})[row['CODIGO']] = row['DESCRIPCION']\n",
    "    return mapa\n",
    "\n",
    "mapa_dicc = construir_mapa_diccionario(diccionario)\n",
    "\n",
    "def decodificar(df, hoja, campo, nueva_col=None):\n",
    "    nueva_col = nueva_col or f\"{campo}_DESC\"\n",
    "    mapa = mapa_dicc.get((hoja, campo), {})\n",
    "    df[nueva_col] = df[campo].map(mapa)\n",
    "    return df\n",
    "\n",
    "# Decodificar SINIESTROS\n",
    "siniestros = decodificar(siniestros, 'SINIESTROS', 'GRAVEDAD')\n",
    "siniestros = decodificar(siniestros, 'SINIESTROS', 'CLASE')\n",
    "siniestros = decodificar(siniestros, 'SINIESTROS', 'CHOQUE')\n",
    "siniestros = decodificar(siniestros, 'SINIESTROS', 'OBJETO_FIJO')\n",
    "siniestros = decodificar(siniestros, 'SINIESTROS', 'CODIGO_LOCALIDAD', 'LOCALIDAD_DESC')\n",
    "siniestros = decodificar(siniestros, 'SINIESTROS', 'DISENO_LUGAR')\n",
    "\n",
    "# Decodificar VEHICULOS\n",
    "vehiculos = decodificar(vehiculos, 'VEHICULOS', 'CLASE')\n",
    "vehiculos = decodificar(vehiculos, 'VEHICULOS', 'SERVICIO')\n",
    "vehiculos = decodificar(vehiculos, 'VEHICULOS', 'MODALIDAD')\n",
    "\n",
    "# Decodificar HIPOTESIS\n",
    "hipotesis = decodificar(hipotesis, 'HIPOTESIS', 'CODIGO_CAUSA')\n",
    "\n",
    "siniestros[['GRAVEDAD','GRAVEDAD_DESC','CLASE','CLASE_DESC','DISENO_LUGAR','DISENO_LUGAR_DESC']].head()"
   ]
