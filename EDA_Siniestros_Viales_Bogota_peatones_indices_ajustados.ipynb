    "# Definir los grupos de edad estándar\n",
    "bins = [0, 17, 28, 45, 60, 100]\n",
    "labels = ['0-17 (Menores)', '18-28 (Jóvenes)', '29-45 (Adultos)', '46-60 (Adultos mayores)', '> 60 (Tercera edad)']\n",
    "df_2 = pd.DataFrame()\n",
    "# Crear la columna de rango a partir de la edad ya limpia\n",
    "df_2['RANGO_EDAD'] = pd.cut(df['EDAD'], bins=bins, labels=labels, right=True)\n",
    "\n",
    "# Graficar conteo por rango etario\n",
    "fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "ax = sns.countplot(data=df_2.dropna(subset=['RANGO_EDAD']), x='RANGO_EDAD', palette='Blues_d', edgecolor='black')\n",
    "\n",
    "for p in ax.patches:\n",
    "    height = int(p.get_height())\n",
    "    if height > 0:\n",
    "        ax.annotate(f'{height:,}',\n",
    "                    (p.get_x() + p.get_width() / 2., height),\n",
    "                    ha='center', va='bottom',\n",
    "                    xytext=(0, 4), textcoords='offset points',\n",
    "                    fontsize=9, fontweight='bold')\n",
    "\n",
    "ax.set_title('Distribución por Grupos Etarios (peatones)', fontsize=12, fontweight='bold', pad=12)\n",
    "ax.set_xlabel('Rango Etario', fontsize=10)\n",
    "ax.set_ylabel('Frecuencia', fontsize=10)\n",
    "ax.spines['top'].set_visible(False)\n",
    "ax.spines['right'].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
