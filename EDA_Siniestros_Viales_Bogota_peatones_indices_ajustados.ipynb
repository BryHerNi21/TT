     "text": [
      "Geometrías nulas : 0\n",
      "Geometrías vacías (sin coordenadas): 0\n",
      "Registros a exportar con geometría válida: 23,447\n"
     ]
    }
   ],
   "source": [
    "import geopandas as gpd\n",
    "\n",
    "# LATITUD/LONGITUD vienen en grados decimales (EPSG:4326, WGS84) segun el diccionario de\n",
    "# la seccion 1.1 -- asignarles directamente crs=\"EPSG:3116\" (como estaba antes) no reproyecta\n",
    "# nada, solo le pone una etiqueta falsa a coordenadas que siguen siendo grados. Eso rompe el\n",
    "# estandar de CRS de todo el pipeline (MAGNA-SIRGAS EPSG:3116) desde el primer paso de export.\n",
    "df = gpd.GeoDataFrame(\n",
    "    df,\n",
    "    geometry=gpd.points_from_xy(df.LONGITUD, df.LATITUD),\n",
    "    crs=\"EPSG:4326\",  # CRS real de origen\n",
    ").to_crs(epsg=3116)  # reproyeccion explicita al estandar del proyecto\n",
    "\n",
    "assert df.crs.to_epsg() == 3116  # verificacion dura, no solo confiar en el atributo .crs\n",
    "\n",
    "sin_coord = df.geometry.is_empty      # points_from_xy con NaN crea puntos VACÍOS, no nulos\n",
    "print(\"Geometrías nulas :\", df.geometry.isna().sum())\n",
    "print(\"Geometrías vacías (sin coordenadas):\", sin_coord.sum())   # esperado: 1.554\n",
    "\n",
    "# Decisión explícita: se exportan solo registros con coordenadas\n",
    "df = df[~sin_coord].copy()\n",
    "print(f\"Registros a exportar con geometría válida: {len(df):,}\")"
   ]
  },
