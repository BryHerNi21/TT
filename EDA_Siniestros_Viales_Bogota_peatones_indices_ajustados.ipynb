   "id": "f2056a21",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "CONDICION\n",
       "CONDUCTOR               306534\n",
       "MOTOCICLISTA             52290\n",
       "PASAJERO/ACOMPAÑANTE     27365\n",
       "PEATON                   23447\n",
       "CICLISTA                 12780\n",
       "Name: count, dtype: int64"
      ]
     },
