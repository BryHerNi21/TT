  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "fa123ce9",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x450 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "categorias = ['Conductor','MOTOCICLISTA','PASAJERO','PEATON','CICLISTA']\n",
    "conteos = actor_vial['CONDICION'].value_counts()\n",
    "porcentajes = actor_vial['CONDICION'].value_counts(normalize=True) * 100\n",
    "colores = ['#4C72B0', '#55A868', '#C44E52']\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4.5))\n",
    "\n",
    "bars = ax.bar(categorias, porcentajes, color=colores, edgecolor='black', alpha=0.85, width=0.55)\n",
    "\n",
    "# Agregar el porcentaje y conteo exacto sobre cada barra\n",
    "for bar, count in zip(bars, conteos):\n",
    "    pct = bar.get_height()\n",
    "    ax.annotate(f'{pct:.1f}%\\n({count:,})',\n",
    "                xy=(bar.get_x() + bar.get_width() / 2, pct),\n",
    "                xytext=(0, 6),\n",
    "                textcoords=\"offset points\",\n",
    "                ha='center', va='bottom', fontsize=9.5, fontweight='bold')\n",
    "\n",
    "ax.set_title('Proporción por Categoría', fontsize=12, fontweight='bold', pad=15)\n",
    "ax.set_ylabel('Porcentaje (%)', fontsize=10)\n",
    "ax.set_ylim(0, max(porcentajes) * 1.18)\n",
    "ax.grid(axis='y', linestyle='--', alpha=0.6)\n",
    "\n",
    "# Ocultar bordes superior y derecho\n",
    "ax.spines['top'].set_visible(False)\n",
    "ax.spines['right'].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "0e05aab9",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "peatonal = actor_vial[actor_vial[\"CONDICION\"] == \"PEATON\"]\n",
    "\n",
    "# 1. Calcular el conteo de valores únicos (únicos reales)\n",
    "val_accidentado = peatonal[\"CODIGO_ACCIDENTADO\"].nunique()\n",
    "val_accidente = peatonal[\"CODIGO_ACCIDENTE\"].nunique()\n",
    "\n",
    "labels = ['Código Accidentado', 'Código Accidente']\n",
    "valores = [val_accidentado, val_accidente]\n",
    "colores = ['steelblue', 'seagreen']\n",
    "\n",
    "# 2. Crear la figura\n",
    "fig, ax = plt.subplots(figsize=(7, 5))\n",
    "ax.set_axisbelow(True)\n",
    "ax.grid(axis='y', linestyle='--', alpha=0.6)\n",
    "\n",
    "# 3. Graficar las barras (2 colores para 2 barras)\n",
    "bars = ax.bar(labels, valores, color=colores, edgecolor='black', alpha=0.85, width=0.5)\n",
    "\n",
    "# 4. Anotar el conteo exacto sobre cada barra\n",
    "for i, v in enumerate(valores):\n",
    "    ax.text(i, v + (max(valores) * 0.02), f\"{v:,}\", ha='center', va='bottom', fontweight='bold', fontsize=10)\n",
    "\n",
    "# 5. Personalizar títulos y límites\n",
    "ax.set_title('Cobertura de Códigos Únicos en Actor Vial', fontsize=12, fontweight='bold', pad=15)\n",
    "ax.set_ylabel('Número de Registros Únicos', fontsize=10)\n",
    "ax.set_ylim(0, max(valores) * 1.15)  # Margen superior para las etiquetas\n",
    "\n",
    "ax.spines['top'].set_visible(False)\n",
    "ax.spines['right'].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
