    "# 1. Generar y ordenar la tabla cruzada\n",
    "tabla_grav_loc = pd.crosstab(df['LOCALIDAD_DESC'], df['ESTADO'])\n",
    "tabla_grav_loc['TOTAL'] = tabla_grav_loc.sum(axis=1)\n",
    "\n",
    "# Ordenar de mayor a menor según el TOTAL para el gráfico\n",
    "tabla_ordenada = tabla_grav_loc.sort_values('TOTAL', ascending=True).drop(columns=['TOTAL'])\n",
    "\n",
    "# 2. Configurar la figura para barras horizontales apiladas\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "ax.set_axisbelow(True)\n",
    "ax.grid(axis='x', linestyle='--', alpha=0.6)\n",
    "\n",
    "# Definir colores para cada estado\n",
    "colores = {'HERIDO': 'darkorange', 'MUERTO': 'crimson'}\n",
