    "import geopandas as gpd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.lines import Line2D\n",
    "from matplotlib.ticker import FuncFormatter\n",
    "\n",
    "CRS_PROY = \"EPSG:3116\"\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 0. PREPARACIÓN DE DATOS\n",
    "# ---------------------------------------------------------\n",
    "gdf = gpd.GeoDataFrame(\n",
    "    df.copy(),\n",
    "    geometry=gpd.points_from_xy(df['LONGITUD'], df['LATITUD']),\n",
    "    crs=\"EPSG:4326\"\n",
    ").to_crs(CRS_PROY)\n",
    "\n",
    "gdf['X'] = gdf.geometry.x\n",
    "gdf['Y'] = gdf.geometry.y\n",
    "\n",
    "# Localidades: el archivo no trae CRS, pero sus coordenadas están en grados\n",
    "loc = gpd.read_file(\"Data/raw/Loca.shp\").set_crs(\"EPSG:4326\").to_crs(CRS_PROY)\n",
    "\n",
    "# Límites del gráfico: tus mismos límites en grados, llevados a metros\n",
    "esquinas = gpd.GeoSeries(\n",
    "    gpd.points_from_xy([LON_MIN, LON_MAX], [LAT_MIN, LAT_MAX]),\n",
    "    crs=\"EPSG:4326\"\n",
    ").to_crs(CRS_PROY)\n",
    "\n",
    "X_MIN, X_MAX = esquinas.x.min(), esquinas.x.max()\n",
    "Y_MIN, Y_MAX = esquinas.y.min(), esquinas.y.max()\n",
    "\n",
    "fmt_miles = FuncFormatter(lambda v, _: f\"{v:,.0f}\".replace(\",\", \".\"))\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Funciones auxiliares\n",
    "# ---------------------------------------------------------\n",
    "def formatear_eje(ax, titulo):\n",
    "    ax.set_title(titulo, fontsize=14, pad=15)\n",
    "    ax.set_xlabel('Este (m) – EPSG:3116', fontsize=11)\n",
    "    ax.set_ylabel('Norte (m) – EPSG:3116', fontsize=11)\n",
    "    ax.set_xlim(X_MIN, X_MAX)\n",
    "    ax.set_ylim(Y_MIN, Y_MAX)\n",
    "    ax.set_aspect('equal')\n",
    "    ax.xaxis.set_major_formatter(fmt_miles)\n",
    "    ax.yaxis.set_major_formatter(fmt_miles)\n",
    "    ax.tick_params(axis='x', labelrotation=45, labelsize=9)\n",
    "    ax.tick_params(axis='y', labelrotation=0, labelsize=9)\n",
    "    ax.grid(True, linestyle='--', linewidth=0.5, alpha=0.4)\n",
    "\n",
    "def flecha_norte(ax):\n",
    "    ax.annotate('N', xy=(0.95, 0.93), xycoords='axes fraction',\n",
    "                ha='center', va='center', fontsize=14, fontweight='bold')\n",
    "    ax.annotate('↑', xy=(0.95, 0.88), xycoords='axes fraction',\n",
    "                ha='center', va='center', fontsize=20)\n",
    "\n",
    "def limites_localidades(ax, lw=0.7, color='#444444'):\n",
    "    loc.boundary.plot(ax=ax, linewidth=lw, edgecolor=color, zorder=3)\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# FIGURA\n",
    "# ---------------------------------------------------------\n",
    "fig, axes = plt.subplots(1, 2, figsize=(17, 8), layout='constrained')\n",
    "\n",
    "# =========================================================\n",
    "# 1. DENSIDAD DE SINIESTROS\n",
    "# =========================================================\n",
    "hb = axes[0].hexbin(\n",
    "    gdf['X'], gdf['Y'],\n",
    "    gridsize=70,\n",
    "    cmap='YlOrRd',\n",
    "    mincnt=1,\n",
    "    bins='log',\n",
    "    extent=(X_MIN, X_MAX, Y_MIN, Y_MAX),\n",
    "    zorder=2\n",
    ")\n",
    "\n",
    "limites_localidades(axes[0])\n",
    "formatear_eje(axes[0], 'Densidad de siniestros con peatón involucrado')\n",
    "\n",
    "cb = fig.colorbar(hb, ax=axes[0], shrink=0.7)\n",
    "cb.set_label('Número de siniestros (escala logarítmica)', fontsize=10)\n",
    "flecha_norte(axes[0])\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# 2. PEATONES ACCIDENTADOS POR ESTADO\n",
    "# =========================================================\n",
    "colores = {'HERIDO': '#FD8D3C', 'MUERTO': '#D7191C'}\n",
    "\n",
    "sub = gdf[gdf['ESTADO'] == 'HERIDO']\n",
    "axes[1].scatter(sub['X'], sub['Y'], s=2, alpha=0.5,\n",
    "                color=colores['HERIDO'], marker='o', zorder=2)\n",
    "\n",
    "sub = gdf[gdf['ESTADO'] == 'MUERTO']\n",
    "axes[1].scatter(sub['X'], sub['Y'], s=10, alpha=0.8,\n",
    "                color=colores['MUERTO'], marker='x', zorder=2)\n",
    "\n",
    "limites_localidades(axes[1])\n",
    "formatear_eje(axes[1], 'Peatones accidentados en Bogotá D.C. por estado (2015–2020)')\n",
    "\n",
    "leyenda = [\n",
    "    Line2D([0], [0], marker='o', color='none',\n",
    "           markerfacecolor=colores['HERIDO'], markeredgecolor=colores['HERIDO'],\n",
    "           markersize=5, label='Herido'),\n",
    "    Line2D([0], [0], marker='x', color='none',\n",
    "           markeredgecolor=colores['MUERTO'], markersize=6, label='Muerto'),\n",
    "]\n",
    "axes[1].legend(handles=leyenda, title='Estado', frameon=True, loc='lower left')\n",
    "flecha_norte(axes[1])\n",
    "\n",
    "plt.show()"
   ]
  },
